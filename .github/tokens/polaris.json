    "spacing.lg": "var(--p-space-400)",
    "radius.sm": "var(--p-border-radius-100)",
    "radius.md": "var(--p-border-radius-200)",
    "radius.lg": "var(--p-border-radius-300)",
    "font.size-sm": "var(--p-font-size-200)",
    "font.size-md": "var(--p-font-size-300)",
