{
  "_source": "https://polaris.shopify.com/tokens/colors",
  "_version": "13",
  "system": "Shopify Polaris",
  "semantic": {
    "color.bg": "var(--p-color-bg)",
    "color.fg": "var(--p-color-text)",
    "color.primary": "var(--p-color-bg-primary)",
    "color.border": "var(--p-color-border)",
    "spacing.xs": "var(--p-space-100)",
