---
import { site } from '../data/site'

const pathname = Astro.url.pathname
---

<header class="sticky top-0 z-50 border-b border-border/60 bg-bg/80 shadow-sm backdrop-blur-xl supports-[backdrop-filter]:bg-bg/55">
  <div class="container-site flex h-16 items-center justify-between">
    <a
      href="/"
      class="flex items-center gap-2 font-semibold text-lg text-fg no-underline"
      aria-label="Argus home"
    >
      <img src="/argus-solid.png" alt="" class="size-8" width="32" height="32" />
      {site.name}
    </a>

    <nav aria-label="Main">
      <ul class="flex items-center gap-1">
        {
          site.nav.map((item) => {
            const isExternal = item.href.startsWith('http')
            const isActive = isExternal
              ? false
              : pathname === item.href ||
                (item.href === '/docs' && pathname.startsWith('/docs'))
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive ? 'page' : undefined}
                  class:list={[
                    'rounded-lg px-3 py-2 text-sm font-medium no-underline transition-colors',
                    isActive
                      ? 'text-accent bg-accent-soft'
                      : 'text-fg-muted hover:text-fg hover:bg-surface-2',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            )
          })
        }
      </ul>
    </nav>
  </div>
</header>