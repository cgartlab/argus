---
import { site } from '../data/site'
import DigitalWater from './DigitalWater.astro'
---

<section id="hero" class="relative overflow-hidden border-b border-border">
  <DigitalWater />
  <div class="container-site hero-content relative z-10 flex flex-col items-center gap-8 py-20 text-center sm:py-28">
    <img src="/argus-flash.png" alt="Argus logo" class="hero-logo size-24" width="96" height="96" />
    <p class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-4 py-1.5 text-sm font-medium text-fg-muted">
      <span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>
      v{site.version} — MIT licensed
    </p>
    <p class="text-sm text-fg-muted">
      Crafted by <a href={site.creatorUrl} class="no-underline text-fg-muted hover:text-fg">CGArtLab</a>
    </p>
    <h1 id="hero-title" class="text-balance relative max-w-4xl text-4xl font-bold tracking-tight text-fg sm:text-5xl">
      Frontend design code review, done right.
      <span class="title-highlight" aria-hidden="true"></span>
    </h1>
    <p class="max-w-2xl text-lg text-fg-muted">
      Argus is a cross-platform AI coding agent specialized in frontend design
      code review — it catches hardcoded values, design token violations,
      accessibility gaps, dark mode breaks, and framework API misuse, then
      hands you copy-ready fixes.
    </p>
    <div class="flex flex-wrap items-center justify-center gap-4">
      <a href={site.appUrl} class="btn-primary no-underline">
        Install the App
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true">
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      </a>
      <a href="/docs" class="btn-secondary no-underline">Read the docs</a>
    </div>
    <p class="text-sm text-fg-muted">
      Runs standalone in any agent framework, or as an automated GitHub App
      review gate.
    </p>
  </div>
</section>

<style>
  /* 主标题平衡换行（替代 inline style，观感不变） */
  .text-balance {
    text-wrap: balance;
  }

  /* Hero 白 shadow 发光 — 浅色模式 = fg-invert 白（dark 下自动反转为深色） */
  .hero-content {
    text-shadow:
      0 0 16px rgba(var(--color-fg-invert-rgb), 0.85),
      0 0 32px rgba(var(--color-fg-invert-rgb), 0.5);
  }
  .hero-logo {
    filter: drop-shadow(0 0 16px rgba(var(--color-fg-invert-rgb), 0.85));
  }

  /* 主标题：灰白色高光叠加层跟随鼠标（不改动文字本身样式） */
  .title-highlight {
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: 0.5rem;
    background:
      radial-gradient(circle 160px at var(--mx, 50%) var(--my, 50%), rgba(var(--color-fg-invert-rgb), 0.4), transparent 62%);
    mix-blend-mode: overlay;
  }
</style>

<script>
  // 主标题高光跟随鼠标
  const heroTitle = document.getElementById('hero-title')
  if (heroTitle) {
    heroTitle.addEventListener('pointermove', (e) => {
      const r = heroTitle.getBoundingClientRect()
      const x = ((e.clientX - r.left) / r.width) * 100
      const y = ((e.clientY - r.top) / r.height) * 100
      heroTitle.style.setProperty('--mx', x + '%')
      heroTitle.style.setProperty('--my', y + '%')
    })
  }
</script>