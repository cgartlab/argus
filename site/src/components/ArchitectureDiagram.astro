---
import type { ArchitectureNode } from '../data/content'

interface Props {
  nodes: ArchitectureNode[]
}
const { nodes } = Astro.props
---

<section id="architecture" class="border-y border-border bg-surface py-20 sm:py-24">
  <div class="container-site">
    <h2 class="text-3xl font-bold tracking-tight text-fg">How it works</h2>
    <p class="mt-3 max-w-2xl text-fg-muted">
      The GitHub App authenticates, your workflow calls the composite action,
      and the rules are injected into the review prompt at runtime.
    </p>

    <ol class="mt-12 flex flex-col items-stretch gap-3 lg:flex-row lg:items-center lg:justify-between">
      {
        nodes.map((node, i) => (
          <li class="flex flex-1 flex-col items-center gap-3 lg:flex-row">
            <div class="w-full rounded-xl border border-border bg-bg p-5 text-center">
              <h3 class="font-semibold text-fg">{node.label}</h3>
              <p class="mt-1 text-xs text-fg-muted break-words">{node.desc}</p>
            </div>
            {
              i < nodes.length - 1 && (
                <svg
                  class="size-5 rotate-90 shrink-0 text-fg-muted lg:rotate-0"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              )
            }
          </li>
        ))
      }
    </ol>

    <p class="mt-10 max-w-3xl text-sm text-fg-muted">
      <strong class="text-fg">Dynamic rules.</strong> AGENTS.md and SKILL.md are
      read at runtime by the composite action. Update them in the Argus
      repository and every consumer repository picks up the changes on its next
      review — no consumer-side changes required.
    </p>
  </div>
</section>