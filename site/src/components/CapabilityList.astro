---
import { Icon } from 'astro-icon/components'
import type { Capability } from '../data/content'

interface Props {
  capabilities: Capability[]
}
const { capabilities } = Astro.props
---

<section id="capabilities" class="py-20 sm:py-24">
  <div class="container-site">
    <h2 class="text-3xl font-bold tracking-tight text-fg">Seven review dimensions</h2>
    <p class="mt-3 max-w-2xl text-fg-muted">
      Every file is audited against the same standards. Findings are grouped by
      severity, and every issue ships with a copy-ready fix.
    </p>
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        capabilities.map((cap) => (
          <li class="card">
            <span class="mb-4 inline-flex size-10 items-center justify-center rounded-lg bg-accent-soft text-accent" aria-hidden="true">
              <Icon name={`lucide:${cap.icon}`} class="size-5" />
            </span>
            <h3 class="text-lg font-semibold text-fg">{cap.title}</h3>
            <p class="mt-2 text-sm text-fg-muted">{cap.desc}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>